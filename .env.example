# 可选，默认使用 data/trackfit-data.json
TRACKFIT_DATA_FILE=data/trackfit-data.json
TRACKFIT_STORAGE=file

# 公网部署必填：使用 `pnpm auth:hash <password>` 生成密码哈希
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
TRACKFIT_ADMIN_USERNAME=admin
TRACKFIT_ADMIN_PASSWORD_HASH=
TRACKFIT_VIEWER_USERNAME=user
TRACKFIT_VIEWER_PASSWORD_HASH=

# 仅用于登录页展示，不参与认证；任一为空时不展示
TRACKFIT_VIEWER_DISPLAY_USERNAME=
TRACKFIT_VIEWER_DISPLAY_PASSWORD=

# Vercel Production 使用 Private Blob 时设置
# TRACKFIT_STORAGE=blob
# TRACKFIT_BLOB_PATH=trackfit/trackfit-data.json
# BLOB_READ_WRITE_TOKEN=

# Docker Compose 可选配置
# 监听所有网卡，允许家庭局域网设备访问
TRACKFIT_BIND_ADDRESS=0.0.0.0
TRACKFIT_PORT=3000
